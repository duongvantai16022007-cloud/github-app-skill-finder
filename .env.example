# ==================== CẤU HÌNH CÁC MÔ HÌNH AI MIỄN PHÍ ====================

# 1. Zhipu AI / GLM Free API (glm-4-flash, glm-z1-flash miễn phí 100%)
# Lấy key miễn phí tại: https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=

# 2. OpenRouter Free Models (z-ai/glm-4.5-air:free, deepseek-r1:free, qwen:free...)
# Lấy key miễn phí tại: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Groq Cloud Free Tier (llama-3.3-70b-versatile, qwen-qwq-32b...)
# Lấy key miễn phí tại: https://console.groq.com/keys
GROQ_API_KEY=

# 4. Google Gemini Free Tier (Tùy chọn)
# Lấy key tại: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Lưu ý: Chế độ "Pollinations Free AI" và "Ollama Local" hoạt động ngay KHÔNG CẦN API Key!)

# ==================== GITHUB API (TÙY CHỌN) ====================
# Có thêm GitHub Token sẽ tăng giới hạn tìm kiếm và mở khóa tìm kiếm sâu file SKILL.md qua Code Search API
GITHUB_TOKEN=
