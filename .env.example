# ==================== FREE AI PROVIDERS CONFIGURATION ====================
# Note: "Free No-API-Key Mode (Smart Hybrid AI)" and "Ollama Local" work out-of-the-box with NO API Key!

# 1. Zhipu AI / GLM Free API (glm-4-flash, glm-z1-flash are 100% free)
# Get free API key at: https://open.bigmodel.cn/usercenter/apikeys
GLM_API_KEY=

# 2. OpenRouter Free Models (z-ai/glm-4.5-air:free, deepseek-r1:free, qwen:free...)
# Get free API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3. Groq Cloud Free Tier (llama-3.3-70b-versatile, qwen-qwq-32b...)
# Get free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# 4. Google Gemini Free Tier (Optional)
# Get free API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ==================== GITHUB API (OPTIONAL) ====================
# Optional: Increases search rate limits and unlocks deep SKILL.md discovery via GitHub Code Search API
GITHUB_TOKEN=
